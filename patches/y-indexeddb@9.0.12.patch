      */
     this._storeUpdate = (update, origin) => {
       if (this.db && origin !== this) {
-        const [updatesStore] = idb.transact(/** @type {IDBDatabase} */ (this.db), [updatesStoreName]);
-        idb.addAutoKey(updatesStore, update);
+        // A throw here would stop the Y.Doc emitting updates for the whole session.
+        try {
+          const [updatesStore] = idb.transact(/** @type {IDBDatabase} */ (this.db), [updatesStoreName]);
+          idb.addAutoKey(updatesStore, update).catch(err => emitError(this, err, 'update'));
+        } catch (err) {
+          this.db = null // closed connection: stop writing for this session
+          emitError(this, err, 'update');
+          return
+        }
         if (++this._dbsize >= PREFERRED_TRIM_SIZE) {
           // debounce store call
           if (this._storeTimeoutId !== null) {
             clearTimeout(this._storeTimeoutId);
