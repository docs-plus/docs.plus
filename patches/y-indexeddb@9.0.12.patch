+            // Back off, so a failing compaction does not re-encode after every pause.
+            storeState(this, false).catch(err => {
+              this._dbsize = 0;
+              emitError(this, err, 'compact');
+            });
             this._storeTimeoutId = null;
           }, this._storeTimeout);
         }
