@@ -226,9 +228,30 @@ class Redis {
      * if the ydoc changed, we'll need to inform other Hocuspocus servers about it.
      */
     async onChange(data) {
-        if (data.transactionOrigin !== this.redisTransactionOrigin) {
-            return this.publishFirstSyncStep(data.documentName, data.document);
+        if (data.transactionOrigin === this.redisTransactionOrigin)
+            return;
+        // docs.plus patch (#595): lossless SyncStep1 throttle. Publish at once, then at most
+        // once per 250 ms window, and always once more after the last change in a window.
+        const documentName = data.documentName;
+        const pending = this.syncStep1Throttle.get(documentName);
+        if (pending) {
+            pending.document = data.document;
+            pending.dirty = true;
+            return;
         }
+        const entry = { document: data.document, dirty: false, timer: undefined };
+        const tick = () => {
+            if (!entry.dirty) {
+                this.syncStep1Throttle.delete(documentName);
+                return;
+            }
+            entry.dirty = false;
+            entry.timer = setTimeout(tick, 250);
+            this.publishFirstSyncStep(documentName, entry.document).catch((error) => console.error(error));
+        };
+        entry.timer = setTimeout(tick, 250);
+        this.syncStep1Throttle.set(documentName, entry);
+        return this.publishFirstSyncStep(documentName, data.document);
     }
     /**
      * Delay unloading to allow syncs to finish
@@ -241,6 +264,9 @@ class Redis {
         });
     }
     async afterUnloadDocument(data) {
+        // docs.plus patch (#595): beforeUnloadDocument waits disconnectDelay (1000 ms), so the trailing publish already ran.
+        clearTimeout(this.syncStep1Throttle.get(data.documentName)?.timer);
+        this.syncStep1Throttle.delete(data.documentName);
         if (data.instance.documents.has(data.documentName))
             return; // skip unsubscribe if the document is already loaded again (maybe fast reconnect)
         this.sub.unsubscribe(this.subKey(data.documentName), (error) => {
@@ -257,6 +283,10 @@ class Redis {
      * Kill the Redlock connection immediately.
      */
     async onDestroy() {
+        // docs.plus patch (#595): stop pending SyncStep1 timers.
+        for (const entry of this.syncStep1Throttle.values())
+            clearTimeout(entry.timer);
+        this.syncStep1Throttle.clear();
         await this.redlock.quit();
         this.pub.disconnect(false);
         this.sub.disconnect(false);
