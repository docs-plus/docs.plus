# =============================================================================
# Hocuspocus Backend (REST, WebSocket, Worker) — minimal image
# Build context: monorepo root (.). Copies only what this backend needs.
# =============================================================================

FROM oven/bun:1-slim AS base
WORKDIR /app

ARG DATABASE_URL
ENV DATABASE_URL=${DATABASE_URL:-postgresql://dummy:dummy@localhost:5432/dummy}

RUN rm -rf /var/lib/apt/lists/* && \
  apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates openssl && rm -rf /var/lib/apt/lists/*

# Backend closure: root + email-templates + hocuspocus.server. Stub package.json for
# other workspaces so lockfile resolution succeeds without copying their source.
COPY package.json bun.lock* bunfig.toml ./
# Shared library config at the monorepo root (single source of truth):
#   - tsconfig.base.json: per-extension tsconfig.json does `extends: "../../tsconfig.base.json"`
#   - tsup.base.ts:       per-extension tsup.config.ts does `from '../../tsup.base'`
# Both are needed by the extension build steps below.
COPY tsconfig.base.json tsup.base.ts ./
COPY packages/email-templates ./packages/email-templates
# floating-popover/floating-tooltip are bundled into hypermultimedia's dist (not external) — need source + build before line below.
COPY packages/floating-popover ./packages/floating-popover
COPY packages/floating-tooltip ./packages/floating-tooltip
COPY apps/hocuspocus.server ./apps/hocuspocus.server
COPY apps/admin-dashboard/package.json ./apps/admin-dashboard/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/release-tooling/package.json ./packages/release-tooling/
# Dev/test-only playground harness (workspace:* devDep of the extensions);
# manifest must resolve for --frozen-lockfile, never shipped in any runtime stage.
COPY packages/playground/package.json ./packages/playground/
# Internal Bun+Playwright CLI (private, never published/shipped); manifest-only
# so the packages/* workspace member resolves for --frozen-lockfile.
COPY packages/document-swarm/package.json ./packages/document-swarm/
# Full source: migration-extensions imports these; package "main" points at dist/ (not in repo).
# hyperlink joined them when document-conversion started importing it at boot.
COPY extensions/extension-hyperlink ./extensions/extension-hyperlink/
COPY extensions/extension-hypermultimedia ./extensions/extension-hypermultimedia/
COPY extensions/extension-indent/package.json ./extensions/extension-indent/
COPY extensions/extension-inline-code ./extensions/extension-inline-code/
COPY extensions/extension-placeholder/package.json ./extensions/extension-placeholder/
COPY packages/supabase/package.json ./packages/supabase/
COPY apps/webapp/package.json ./apps/webapp/

# Dev install + build dist/, then prune — production-only install cannot run tsup.
RUN bun install --frozen-lockfile --ignore-scripts
RUN bun run --filter @docs.plus/floating-popover build \
  && bun run --filter @docs.plus/floating-tooltip build \
  && bun run --filter @docs.plus/extension-hyperlink build \
  && bun run --filter @docs.plus/extension-hypermultimedia build \
  && bun run --filter @docs.plus/extension-inline-code build
RUN bun install --frozen-lockfile --production --ignore-scripts

# Production runs its own install + generate; no need to generate in base.
# -----------------------------------------------------------------------------
# Production: same layout, fresh install in stage (no root node_modules copy)
# -----------------------------------------------------------------------------
FROM oven/bun:1-slim AS production
WORKDIR /app

RUN rm -rf /var/lib/apt/lists/* && \
  apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates openssl && rm -rf /var/lib/apt/lists/*
# -m gives appuser a writable HOME so its bunx cache (below) persists in the image.
RUN groupadd -r appuser && useradd -r -m -g appuser appuser

# --chown on the COPY stamps ownership as the layer is written. A later
# `chown -R` instead rewrites every inode, so Docker stores a second full copy
# of the tree: measured 1.91 GB in one layer, and 125.3 s of a 280.9 s backend
# solve on the amd64 host. It costs only 1.8 s on an arm64 laptop, so judge this
# from the production build log, never from a local one.
COPY --from=base --chown=appuser:appuser /app/package.json /app/bun.lock* /app/bunfig.toml ./
COPY --from=base --chown=appuser:appuser /app/packages ./packages
# hocus source + all workspace members (apps/* + built extensions/*) for --frozen-lockfile + prisma generate
COPY --from=base --chown=appuser:appuser /app/apps ./apps
COPY --from=base --chown=appuser:appuser /app/extensions ./extensions

# --filter scopes the install to the backend's own closure. Without it the root
# install resolves every workspace member, so this image shipped next@15.5.21,
# next@16.2.12 and four @next/swc native binaries — about 950 MB the REST, WS
# and worker processes never import. The webapp and admin manifests are still
# COPY'd above, because --frozen-lockfile must resolve every workspace member.
RUN bun install --frozen-lockfile --production --ignore-scripts --filter '@docs.plus/hocuspocus'
RUN cd apps/hocuspocus.server && bunx prisma@6.19.3 generate

COPY --from=base /app/apps/hocuspocus.server/scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# storage.local.ts:16 resolves ./temp/<plugin> against process.cwd(), which the
# entrypoint sets to /app/apps/hocuspocus.server. The COPY --chown above already
# owns that tree, so only the write path is stamped here. node_modules and the
# generated Prisma client stay root-owned and read-only to the runtime user.
RUN mkdir -p /app/apps/hocuspocus.server/temp \
  && chown appuser:appuser /app/apps/hocuspocus.server/temp

USER appuser
# Warm the Prisma CLI into appuser's bunx cache so the entrypoint migrate runs
# offline (prisma is a devDep, pruned by --production, else downloaded per boot).
RUN cd /app/apps/hocuspocus.server && bunx prisma@6.19.3 --version
EXPOSE 4000 4001 4002
# Probe the app's /health endpoint (replaces the old no-op `bun --version`).
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:'+(process.env.APP_PORT||'4000')+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["bun", "src/index.ts"]
