@base = http://localhost:4000
@wsInternal = http://localhost:4003
@serviceRoleKey = {{$dotenv SUPABASE_SERVICE_ROLE_KEY}}
@documentId = Igm8eYmRB6a593e56j9
@version = 3

### List documents
GET {{base}}/api/documents

### Search by title
GET {{base}}/api/documents?title=cats

### Get one document by slug
GET {{base}}/api/documents/test

### Create a document
POST {{base}}/api/documents
content-type: application/json

{
  "title": "My new document",
  "slug": "dr3f3d33"
}

### Create a document with metadata
POST {{base}}/api/documents
content-type: application/json

{
  "title": "Demo page",
  "slug": "demopage",
  "description": "new Demo",
  "keywords": ["test", "demo231"]
}

### Update document metadata
PUT {{base}}/api/documents/{{documentId}}
content-type: application/json

{
  "title": "My new s",
  "description": "new Demo hjhjh",
  "keywords": ["test", "cats", "dogs3", "demo"]
}

# ---------------------------------------------------------------------------
# Document content (service-role only)
# ---------------------------------------------------------------------------

### Read content as Tiptap JSON
GET {{base}}/api/documents/{{documentId}}/content
Authorization: Bearer {{serviceRoleKey}}

### Read content as plain text
GET {{base}}/api/documents/{{documentId}}/content?format=text
Authorization: Bearer {{serviceRoleKey}}

### Append a paragraph (live collaborators see it immediately)
PATCH {{base}}/api/documents/{{documentId}}/content?mode=append
Authorization: Bearer {{serviceRoleKey}}
content-type: application/json

{
  "content": {
    "type": "doc",
    "content": [
      { "type": "paragraph", "content": [{ "type": "text", "text": "Appended by automation." }] }
    ]
  }
}

### Replace the whole body (must start with a level-1 heading)
PATCH {{base}}/api/documents/{{documentId}}/content?mode=replace
Authorization: Bearer {{serviceRoleKey}}
content-type: application/json

{
  "content": {
    "type": "doc",
    "content": [
      { "type": "heading", "attrs": { "level": 1 }, "content": [{ "type": "text", "text": "Quarterly report" }] },
      { "type": "paragraph", "content": [{ "type": "text", "text": "Revenue grew 12%." }] }
    ]
  }
}

### Name the version this write mints
### Retention never thins a named row — leave bulk-import chunks unnamed.
PATCH {{base}}/api/documents/{{documentId}}/content?mode=append
Authorization: Bearer {{serviceRoleKey}}
content-type: application/json

{
  "commitMessage": "Imported the Q3 figures",
  "content": {
    "type": "doc",
    "content": [
      { "type": "paragraph", "content": [{ "type": "text", "text": "Revenue grew 12%." }] }
    ]
  }
}

### Clear the body (empty title heading)
PATCH {{base}}/api/documents/{{documentId}}/content?mode=replace
Authorization: Bearer {{serviceRoleKey}}
content-type: application/json

{
  "content": { "type": "doc", "content": [{ "type": "heading", "attrs": { "level": 1 } }] }
}

### Create a document with initial content
POST {{base}}/api/documents
Authorization: Bearer {{serviceRoleKey}}
content-type: application/json

{
  "title": "Generated report",
  "slug": "generated-report",
  "ownerId": "00000000-0000-0000-0000-000000000000",
  "content": {
    "type": "doc",
    "content": [
      { "type": "heading", "attrs": { "level": 1 }, "content": [{ "type": "text", "text": "Generated report" }] },
      { "type": "paragraph", "content": [{ "type": "text", "text": "Written by an automation." }] }
    ]
  }
}

### INTERNAL ONLY — the collaboration process's apply endpoint.
### Not Traefik-routed; reachable from the docker network or localhost. REST
### forwards here. Call it directly only when debugging the hop itself.
# POST {{wsInternal}}/internal/documents/{{documentId}}/content
# Authorization: Bearer {{serviceRoleKey}}
# content-type: application/json
#
# {
#   "mode": "append",
#   "content": {
#     "type": "doc",
#     "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "direct hop" }] }]
#   }
# }

# ---------------------------------------------------------------------------
# Document versions (service-role only)
# ---------------------------------------------------------------------------
# Every debounced save already stores a version. A checkpoint only names one,
# and a named row is the one retention never thins.

### List the history, newest first
GET {{base}}/api/documents/{{documentId}}/versions
Authorization: Bearer {{serviceRoleKey}}

### List the second page (limit is 1-100, default 50)
GET {{base}}/api/documents/{{documentId}}/versions?limit=10&offset=10
Authorization: Bearer {{serviceRoleKey}}

### Name the next stored version
### The 200 means the save was triggered, not that the row exists — list again
### to see it land. Naming an unchanged document still mints a row.
POST {{base}}/api/documents/{{documentId}}/versions
Authorization: Bearer {{serviceRoleKey}}
content-type: application/json

{
  "name": "Before the board review"
}

### Read one version as Tiptap JSON
GET {{base}}/api/documents/{{documentId}}/versions/{{version}}
Authorization: Bearer {{serviceRoleKey}}

### Read one version as plain text
GET {{base}}/api/documents/{{documentId}}/versions/{{version}}?format=text
Authorization: Bearer {{serviceRoleKey}}

### Delete one version — permanent
### The newest version refuses with 409: it is the base a cold load reads.
DELETE {{base}}/api/documents/{{documentId}}/versions/{{version}}
Authorization: Bearer {{serviceRoleKey}}

### Restore a version into the live document
### Appends two rows: the pre-restore backup (returned as backupVersion) and
### the restore itself. Not the trash restore — that one is
### POST /api/documents/{{documentId}}/restore and touches no content.
POST {{base}}/api/documents/{{documentId}}/versions/{{version}}/restore
Authorization: Bearer {{serviceRoleKey}}

### INTERNAL ONLY — the collaboration process's version endpoints.
### Same rules as the internal apply endpoint above: not Traefik-routed, REST
### forwards here. Call directly only when debugging the hop itself.
# POST {{wsInternal}}/internal/documents/{{documentId}}/versions
# Authorization: Bearer {{serviceRoleKey}}
# content-type: application/json
#
# { "name": "direct hop checkpoint" }

# POST {{wsInternal}}/internal/documents/{{documentId}}/versions/{{version}}/restore
# Authorization: Bearer {{serviceRoleKey}}
# content-type: application/json
#
# {}

# ---------------------------------------------------------------------------
# Document changes (service-role only)
# ---------------------------------------------------------------------------
# Read-only. `since` and `until` bound the version row's `createdAt`, never the
# version number. Both need an ISO instant carrying an offset; `Z` is one. Drop
# it and the route answers 400. A numeric offset must be percent-encoded as
# %2B01:00 — a raw `+` in a query value decodes to a space and fails validation.

### What changed since a fixed instant - counts only
GET {{base}}/api/documents/{{documentId}}/changes?since=2026-08-01T00:00:00Z
Authorization: Bearer {{serviceRoleKey}}

### The same window with the heading tree
### `sections` holds the whole outline, unchanged headings included.
GET {{base}}/api/documents/{{documentId}}/changes?since=2026-08-01T00:00:00Z&scope=headings
Authorization: Bearer {{serviceRoleKey}}

### A closed window - `until` defaults to the request instant when omitted
GET {{base}}/api/documents/{{documentId}}/changes?since=2026-08-01T00:00:00Z&until=2026-08-31T23:59:59Z
Authorization: Bearer {{serviceRoleKey}}

### A `since` older than every surviving row
### `baseline` comes back null and the whole document reads as added.
GET {{base}}/api/documents/{{documentId}}/changes?since=2000-01-01T00:00:00Z&scope=headings
Authorization: Bearer {{serviceRoleKey}}

### Equal ends report no change; a reversed pair is a 400
GET {{base}}/api/documents/{{documentId}}/changes?since=2026-08-01T00:00:00Z&until=2026-08-01T00:00:00Z
Authorization: Bearer {{serviceRoleKey}}

# ---------------------------------------------------------------------------
# Document conversion (service-role only)
# ---------------------------------------------------------------------------
# Export responses are the raw file, not the house envelope — save them rather
# than reading them in the response pane.

### Export as .docx (the default format)
GET {{base}}/api/documents/{{documentId}}/export
Authorization: Bearer {{serviceRoleKey}}

### Export as .docx (explicit)
GET {{base}}/api/documents/{{documentId}}/export?format=docx
Authorization: Bearer {{serviceRoleKey}}

### Export as Markdown
GET {{base}}/api/documents/{{documentId}}/export?format=md
Authorization: Bearer {{serviceRoleKey}}

### Export as .odt
GET {{base}}/api/documents/{{documentId}}/export?format=odt
Authorization: Bearer {{serviceRoleKey}}

### Import a .docx — returns JSON and writes nothing
### `< ./sample.docx` reads a file you supply; the repo ships no fixture.
POST {{base}}/api/documents/{{documentId}}/import
Authorization: Bearer {{serviceRoleKey}}
Content-Type: multipart/form-data; boundary=----DocsPlusBoundary

------DocsPlusBoundary
Content-Disposition: form-data; name="documentFile"; filename="sample.docx"
Content-Type: application/vnd.openxmlformats-officedocument.wordprocessingml.document

< ./sample.docx
------DocsPlusBoundary--

### Import Markdown — same field name, no raw-body variant
POST {{base}}/api/documents/{{documentId}}/import
Authorization: Bearer {{serviceRoleKey}}
Content-Type: multipart/form-data; boundary=----DocsPlusBoundary

------DocsPlusBoundary
Content-Disposition: form-data; name="documentFile"; filename="sample.md"
Content-Type: text/markdown

< ./sample.md
------DocsPlusBoundary--

### Apply an import: paste `data.content` from the response above.
### Ask for mode=append — the route defaults to replace, and imported content
### carries no toc-id, so a replace re-keys every heading and orphans its chat
### channel, fold state and ?id= link. Drop the pasted content[0] first: every
### import opens on a title heading, and appending one lands it mid-document.
PATCH {{base}}/api/documents/{{documentId}}/content?mode=append
Authorization: Bearer {{serviceRoleKey}}
content-type: application/json

{
  "content": {
    "type": "doc",
    "content": [
      { "type": "paragraph", "content": [{ "type": "text", "text": "Paste the imported content here." }] }
    ]
  }
}

# ---------------------------------------------------------------------------
# Last opened
# ---------------------------------------------------------------------------

### Owner live list, Last opened sort
GET {{base}}/api/documents?ownerId=<uuid>&sort=lastOpenedAt_desc
token: <jwt>

### Stamp Last opened
POST {{base}}/api/documents/{{documentId}}/opened
token: <jwt>

