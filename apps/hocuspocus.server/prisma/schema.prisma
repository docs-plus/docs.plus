generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Documents {
  id            Int              @id @default(autoincrement())
  documentId    String
  version       Int              @default(1)
  commitMessage String?
  data          Bytes
  // Attribution is projection-only — never a read predicate, so no index.
  trigger       String?
  triggeredBy   String?
  contributors  String[]         @default([])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  metadata      DocumentMetadata @relation(fields: [documentId], references: [documentId], onDelete: Cascade)

  @@unique([documentId, version], name: "Documents_documentId_version_unique")
  // Not redundant with the unique above: the narrowest documentId-leading cover for
  // the version-list count, and what the reaper's Incremental Sort presorts on.
  @@index([documentId])
  @@index([createdAt])
}

model DocumentMetadata {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String?
  description String?
  keywords    String?
  isPrivate   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  documentId  String    @unique
  readOnly    Boolean   @default(false)
  ownerId     String?
  email       String?
  deletedAt   DateTime? // Soft-delete tombstone; the reaper purges the footprint after retention.
  // First-page extract for the owner Documents grid. NULL = never extracted.
  // Application SQL writes this column without touching updatedAt.
  preview Json?
  // Owner pad open. Application SQL writes this column without touching updatedAt.
  lastOpenedAt DateTime?

  documents     Documents[]
  clientAuthors DocumentClientAuthor[]
  favorites     DocumentFavorite[]

  @@index([ownerId])
  @@index([deletedAt])
  @@index([ownerId, lastOpenedAt])
}

// Counts how many times a slug's document has been purged, so a reused slug cannot
// derive the purged document's id.
// No @default: "no row" already means INITIAL_EPOCH, so a writer that omits the
// column would silently mint that same state instead of failing.
model DocumentSlugEpoch {
  slug      String   @id
  epoch     Int
  updatedAt DateTime @updatedAt
}

// The durable record that a documentId was purged. Without it a no-row lookup in
// onAuthenticate cannot tell "purged" from "never existed", so a tab that missed
// the close frame reconnects and syncs erased content back up. No relation to
// DocumentMetadata: a cascade would drop the tombstone with the row it outlives.
model DocumentPurgeTombstone {
  documentId String   @id
  purgedAt   DateTime @default(now())
}

// Names the author behind a Yjs clientID so a version diff can attribute blocks.
// Records who first claimed the id on a live socket, not proof of authorship.
model DocumentClientAuthor {
  documentId  String
  /// Yjs draws clientIDs from the full uint32 range; roughly half exceed int4.
  clientId    BigInt
  userId      String
  isAnonymous Boolean          @default(false)
  firstSeenAt DateTime         @default(now())
  metadata    DocumentMetadata @relation(fields: [documentId], references: [documentId], onDelete: Cascade)

  @@id([documentId, clientId])
}

// Soft-delete keeps the join so restore stays favorited. Purge cascade drops it.
model DocumentFavorite {
  userId     String
  documentId String
  createdAt  DateTime         @default(now())
  metadata   DocumentMetadata @relation(fields: [documentId], references: [documentId], onDelete: Cascade)

  @@id([documentId, userId])
  @@index([userId])
}

// ============================================================================
// Idempotency Tables
// Prevent duplicate sends on worker retries
// ============================================================================

model EmailSentLog {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique // email:{jobId}
  messageId      String? // SMTP/provider message ID
  recipient      String
  emailType      String? // notification type
  sentAt         DateTime @default(now())
  expiresAt      DateTime @default(dbgenerated("(now() + '7 days'::interval)"))

  @@index([expiresAt])
  @@index([recipient, sentAt])
}

model PushSentLog {
  id                String   @id @default(cuid())
  idempotencyKey    String   @unique // push:{jobId}
  userId            String
  subscriptionCount Int      @default(0) // How many devices received
  sentAt            DateTime @default(now())
  expiresAt         DateTime @default(dbgenerated("(now() + '7 days'::interval)"))

  @@index([expiresAt])
  @@index([userId, sentAt])
}
