# HTTP listener inside the container
PORT=4050
# Persistent SQLite database path (mounted Docker volume in production)
SQLITE_PATH=/data/relay.sqlite

# Target GitHub repository (owner/name)
GITHUB_REPOSITORY=docs-plus/docs.plus
# Secret shared with the GitHub repository webhook (required)
GITHUB_WEBHOOK_SECRET=
# Optional fine-grained read-only token for compare API (>20 commits) and digest queries
GITHUB_TOKEN=

# REST-only Discord Bot Token (required; no Gateway WebSocket process)
DISCORD_BOT_TOKEN=
# Public community activity channel ID (required)
DISCORD_GITHUB_CHANNEL_ID=
# Maintainer accountability channel ID (optional; defaults to DISCORD_GITHUB_CHANNEL_ID)
DISCORD_TRIAGE_CHANNEL_ID=
# Release announcements channel ID (required)
DISCORD_RELEASES_CHANNEL_ID=

# Opt-in GitHub login -> Discord numeric ID map for accountability pings
DISCORD_USERS_MAP_PATH=/app/apps/github-relay/discord-users.json
# Optional bearer token for manual POST /internal/digest triggers
RELAY_ADMIN_TOKEN=

# Coalescing windows (milliseconds)
PUSH_COALESCE_MS=12000
ISSUE_OPEN_COALESCE_MS=10000
TRIAGE_BURST_WINDOW_MS=45000
STAR_BURST_WINDOW_MS=30000

# Scheduled digests (UTC)
DIGEST_ENABLED=true
DAILY_DIGEST_HOUR_UTC=9
BIWEEKLY_REPORT_DAY_UTC=5
BIWEEKLY_REPORT_HOUR_UTC=16
MONTHLY_REPORT_DAY_UTC=1
MONTHLY_REPORT_HOUR_UTC=16

# Product and documentation links rendered on release cards
APP_URL=https://docs.plus
SELF_HOST_DOCS_URL=https://github.com/docs-plus/docs.plus/blob/main/docs/self-hosting/README.md
