{
  "enabledPlugins": {
    "buildkite@claude-plugins-official": true
  },
  "outputStyle": "docsplus-simplified-english",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/hooks/design-system-lock.ts\"",
            "timeout": 10,
            "statusMessage": "Checking the design system lock"
          }
        ]
      }
    ]
  }
}
