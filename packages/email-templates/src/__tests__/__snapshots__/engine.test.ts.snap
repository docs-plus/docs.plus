  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f5f5f5;">
    <tr>
      <td align="center" style="padding: 40px 20px;">
        <table role="presentation" class="content" width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border: 1px solid #dce3ed; border-radius: 10px; overflow: hidden;">

          <tr>
            <td style="background: #1a73e8; padding: 24px 32px; text-align: center;">
              <h1 style="margin: 0; color: #ffffff; font-size: 22px; font-weight: 600; letter-spacing: -0.3px;">docs.plus</h1>
            </td>
          </tr>

          <tr>
            <td style="padding: 32px;">
              <p style="margin: 0 0 24px; color: #1f2937; font-size: 16px; font-weight: 600;">
  New Document Created
</p>

<!-- Creator Card -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f9fafb; border-radius: 10px; border: 1px solid #e5e7eb; margin-bottom: 24px;">
  <tr>
    <td style="padding: 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td width="60" valign="top">
            <table role="presentation" cellpadding="0" cellspacing="0" style="width: 48px; height: 48px; border-radius: 50%; background: #1a73e8;">
    <tr>
      <td align="center" valign="middle" style="color: #ffffff; font-weight: 600; font-size: 19px; font-family: Helvetica, Arial, sans-serif;">
        A
      </td>
    </tr>
  </table>
          </td>
          <td style="padding-left: 12px;" valign="top">
            <p style="margin: 0 0 4px; color: #1f2937; font-size: 15px; font-weight: 600;">
              Alice Chen
            </p>
            
            <p style="margin: 0; color: #69707e; font-size: 13px;">alice@example.com</p>
            
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Document Details -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
  <tr>
    <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">
      <strong style="color: #1f2937; font-size: 13px;">Name</strong>
    </td>
    <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; color: #69707e; font-size: 13px;">
      Product Roadmap Q1
    </td>
  </tr>
  <tr>
    <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">
      <strong style="color: #1f2937; font-size: 13px;">Slug</strong>
    </td>
    <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">
      <code style="background: #f3f4f6; padding: 2px 6px; border-radius: 4px; font-size: 12px; color: #69707e;">product-roadmap-q1</code>
    </td>
  </tr>
  <tr>
    <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">
      <strong style="color: #1f2937; font-size: 13px;">ID</strong>
    </td>
    <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">
      <code style="background: #f3f4f6; padding: 2px 6px; border-radius: 4px; font-size: 11px; color: #636a76;">doc-abc-123</code>
    </td>
  </tr>
