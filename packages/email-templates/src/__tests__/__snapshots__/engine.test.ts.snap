exports[`renderUnsubscribePage snapshot — success 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Unsubscribed - docs.plus</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root { color-scheme: light dark; }
    body {
      font-family: Helvetica, Arial, sans-serif;
      background: #eef1f6;
      color: #1f2937;
      -webkit-font-smoothing: antialiased;
    }
    main {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px 16px;
    }
    .column {
      width: min(100%, 400px);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    a:focus-visible {
      outline: 2px solid #1a73e8;
      outline-offset: 2px;
    }
    .brand {
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 40px;
      border-radius: 8px;
      color: #1f2937;
      text-decoration: none;
      font-size: 18px;
      line-height: 28px;
      font-weight: 700;
      letter-spacing: -0.025em;
    }
    .card {
      background: #ffffff;
      border: 1px solid #dce3ed;
      border-radius: 10px;
      box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
      overflow: hidden;
    }
    .body {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 24px;
    }
    .heading {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    h1 {
      font-size: 20px;
      line-height: 28px;
      font-weight: 600;
      text-wrap: balance;
    }
    .message {
      color: #69707e;
      font-size: 14px;
      line-height: 20px;
    }
    .primary {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0 16px;
      border-radius: 8px;
      background: #1a73e8;
      color: #ffffff;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
    }
    .strip {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 4px 16px;
      min-height: 48px;
      padding: 14px 24px;
      border-top: 1px solid #dce3ed;
      color: #636a76;
      font-size: 13px;
      line-height: 20px;
    }
    .email { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }
    .strip nav { margin-left: auto; }
    .quiet {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      margin: -10px 0;
      color: #1a73e8;
      text-decoration: none;
      font-weight: 600;
    }
    /* A web page, not mail: copy the webapp default dark theme (globals.scss). */
    @media (prefers-color-scheme: dark) {
      body { background: #0f172a; }
      body, .brand { color: #e5e7eb; }
      .card { background: #0b1220; border-color: #2d3f57; }
      .strip { border-top-color: #2d3f57; }
      .message, .strip { color: #a4a7ae; }
      .primary { background: #6ea8ff; color: #0b1220; }
      .quiet { color: #6ea8ff; }
      a:focus-visible { outline-color: #6ea8ff; }
    }
  </style>
</head>
<body>
  <main>
    <div class="column">
      <a class="brand" href="https://docs.plus" aria-label="docs.plus home">
        <img src="https://docs.plus/icons/logo.svg" width="24" height="24" alt="">
        <span>docs.plus</span>
      </a>
      <article class="card" aria-labelledby="unsubscribe-title">
        <div class="body">
          <div class="heading">
            <h1 id="unsubscribe-title">Unsubscribed</h1>
            <p class="message">You have been unsubscribed.</p>
          </div>
          <a class="primary" href="https://docs.plus/#settings?tab=notifications">Manage preferences</a>
        </div>
        
        <div class="strip">
          
          <p class="email">jane@example.com</p>
          
          
          <nav aria-label="Other pages">
            <a class="quiet" href="https://docs.plus">Go to docs.plus</a>
          </nav>
          
        </div>
        
      </article>
    </div>
  </main>
</body>
</html>
"
`;

