<% it.blocks.forEach(function(block) { %>
<% if (block.kind === 'sheet') { %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 8px;">
  <tr>
    <td style="padding-bottom: 18px; border-bottom: 1px solid <%= it.h.COLORS.sheetBorder %>;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td width="36" valign="middle">
            <a href="<%= block.url %>" style="text-decoration: none;">
              <svg width="22" height="28" viewBox="0 0 22 28" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                <path fill="#1a73e8" d="M2 1h12l6 6v19a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                <path fill="#ffffff" d="M14 1v6h6"/>
                <path fill="#1a73e8" d="M10 12h2v3h3v2h-3v3h-2v-3H7v-2h3z"/>
              </svg>
            </a>
          </td>
          <td valign="middle" style="padding-left: 10px;">
            <a href="<%= block.url %>" style="color: #0f172a; font-size: 20px; font-weight: 600; line-height: 1.2; text-decoration: none;"><%= block.name %></a>
          </td>
          <td width="120" align="right" valign="middle">
            <table role="presentation" cellpadding="0" cellspacing="0" align="right">
              <tr>
                <td valign="middle" style="padding-right: 14px;">
                  <a href="<%= block.notificationsUrl %>" style="text-decoration: none; color: #0f172a;">
                    <span style="position: relative; display: inline-block; width: 22px; height: 22px; line-height: 22px;">
                      <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="display: block;">
                        <path fill="none" stroke="#0f172a" stroke-width="1.75" d="M6 9a6 6 0 1 1 12 0c0 7 3 7 3 7H3s3 0 3-7"/>
                        <path fill="none" stroke="#0f172a" stroke-width="1.75" d="M10 19a2 2 0 0 0 4 0"/>
                      </svg>
                      <span style="position: absolute; top: -5px; right: -7px; min-width: 14px; height: 14px; padding: 0 3px; border-radius: 999px; background: #dc2626; color: #ffffff; font-size: 9px; font-weight: 700; line-height: 14px; text-align: center;"><%= block.badge %></span>
                    </span>
                  </a>
                </td>
                <td valign="middle"><%~ it.h.avatar(block.recipientName || 'You', undefined, 48) %></td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
<% } else if (block.kind === 'heading') { %>
<p style="margin: 22px 0 0;">
  <a href="<%= block.url %>" style="color: #0f172a; font-size: 18px; font-weight: 700; line-height: 1.25; text-decoration: none;"><%= block.text %></a>
</p>
<% } else if (block.kind === 'notice') { %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 12px;">
  <tr>
    <td width="40" valign="top"><%~ it.h.avatar(block.notice.sender_name, block.notice.sender_avatar_url, 32) %></td>
    <td style="padding-left: 10px;" valign="top">
      <p style="margin: 0; color: <%= it.h.COLORS.text %>; font-size: 14px; font-weight: 600; line-height: 1.3;">
        <span style="color: <%= it.h.COLORS.primary %>;"><%= it.h.notificationIcon(block.notice.type) %></span> <%= block.notice.sender_name %>
      </p>
      <p style="margin: 2px 0 0; color: <%= it.h.COLORS.textMuted %>; font-size: 13px; line-height: 1.4;"><%= it.h.truncate(block.notice.message_preview, it.h.DIGEST_PREVIEW_CHARS) %></p>
    </td>
    <td width="48" align="right" valign="middle">
      <a href="<%= block.notice.action_url %>" style="color: <%= it.h.COLORS.primary %>; font-size: 13px; font-weight: 600; text-decoration: none;">View</a>
    </td>
  </tr>
</table>
<% } else if (block.kind === 'runs') { %>
<p style="margin: 12px 0 0; color: <%= it.h.COLORS.text %>; font-size: 15px; line-height: 1.45;">
<% block.runs.forEach(function(run) { %><span style="<%= it.h.changeRunStyle(run.kind) %>"><%= run.text %></span><% }) %>
</p>
<% } else if (block.kind === 'more') { %>
<p style="margin: 8px 0 0; color: <%= it.h.COLORS.textLight %>; font-size: 12px; text-align: center;">+<%= block.count %> more in this channel</p>
<% } else if (block.kind === 'status') { %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 22px 0 28px; border-top: 1px solid <%= it.h.COLORS.sheetBorder %>;">
  <tr>
    <td valign="middle" style="padding-top: 10px; color: <%= it.h.COLORS.textMuted %>; font-size: 12px; line-height: 1.4;"><%= block.line %></td>
    <td align="right" valign="middle" style="padding-top: 10px; font-size: 12px; white-space: nowrap;"><%~ it.footerHtml %></td>
  </tr>
</table>
<% } else if (block.kind === 'home') { %>
<p style="margin: 0 0 16px; font-size: 14px;"><a href="<%= block.url %>" style="color: <%= it.h.COLORS.primary %>; text-decoration: none;"><%= it.h.APP_NAME %></a></p>
<p style="margin: 0; font-size: 12px;"><%~ it.footerHtml %></p>
<% } %>
<% }) %>
