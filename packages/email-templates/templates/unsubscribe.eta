<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= it.title %> - <%= it.h.APP_NAME %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root { color-scheme: light dark; }
    body {
      font-family: <%~ it.h.FONT_STACK %>;
      background: <%= it.h.COLORS.padWell %>;
      color: <%= it.h.COLORS.text %>;
      -webkit-font-smoothing: antialiased;
    }
    main {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px 16px;
    }
    .column {
      width: min(100%, 400px);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    a:focus-visible, button:focus-visible {
      outline: 2px solid <%= it.h.COLORS.primary %>;
      outline-offset: 2px;
    }
    .brand {
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 40px;
      border-radius: <%= it.h.RADIUS.md %>;
      color: <%= it.h.COLORS.text %>;
      text-decoration: none;
      font-size: 18px;
      line-height: 28px;
      font-weight: 700;
      letter-spacing: -0.025em;
    }
    .card {
      background: <%= it.h.COLORS.white %>;
      border: 1px solid <%= it.h.COLORS.sheetBorder %>;
      border-radius: <%= it.h.RADIUS.lg %>;
      box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
      overflow: hidden;
    }
    .body {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 24px;
    }
    .heading {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    h1 {
      font-size: 20px;
      line-height: 28px;
      font-weight: 600;
      text-wrap: balance;
    }
    .message {
      color: <%= it.h.COLORS.textMuted %>;
      font-size: 14px;
      line-height: 20px;
    }
    .primary {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 0 16px;
      border-radius: <%= it.h.RADIUS.md %>;
      --btn-bg: <%= it.h.COLORS.primary %>;
      background: var(--btn-bg);
      color: <%= it.h.COLORS.white %>;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
    }
    button.primary {
      width: 100%;
      border: 0;
      font-family: inherit;
      cursor: pointer;
    }
    /* daisyUI btn hover: the same hue, 7% darker. */
    @media (hover: hover) {
      .primary:hover { background: color-mix(in oklab, var(--btn-bg), #000 7%); }
    }
    .strip {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 4px 16px;
      min-height: 48px;
      padding: 14px 24px;
      border-top: 1px solid <%= it.h.COLORS.sheetBorder %>;
      color: <%= it.h.COLORS.textMeta %>;
      font-size: 13px;
      line-height: 20px;
    }
    .email { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }
    .strip nav { display: flex; gap: 16px; margin-left: auto; }
    .quiet {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      margin: -10px 0;
      color: <%= it.h.COLORS.primary %>;
      text-decoration: none;
      font-weight: 600;
    }
    /* A web page, not mail: copy the webapp default dark theme (globals.scss). */
    @media (prefers-color-scheme: dark) {
      body { background: #0f172a; }
      body, .brand { color: #e5e7eb; }
      .card { background: #0b1220; border-color: #2d3f57; }
      .strip { border-top-color: #2d3f57; }
      .message, .strip { color: #a4a7ae; }
      .primary { --btn-bg: #6ea8ff; color: #0b1220; }
      .quiet { color: #6ea8ff; }
      a:focus-visible, button:focus-visible { outline-color: #6ea8ff; }
    }
  </style>
</head>
<body>
  <main>
    <div class="column">
      <a class="brand" href="<%= it.h.APP_URL %>" aria-label="<%= it.h.APP_NAME %> home">
        <img src="<%= it.h.APP_URL %>/icons/logo.svg" width="24" height="24" alt="">
        <span><%= it.h.APP_NAME %></span>
      </a>
      <article class="card" aria-labelledby="unsubscribe-title">
        <div class="body">
          <div class="heading">
            <h1 id="unsubscribe-title"><%= it.title %></h1>
            <p class="message"><%= it.message %></p>
          </div>
          <% if (it.confirm) { %>
          <form method="post">
            <input type="hidden" name="confirm" value="yes">
            <button class="primary" type="submit">Unsubscribe</button>
          </form>
          <% } else { %>
          <a class="primary" href="<%= it.manageUrl %>">Manage preferences</a>
          <% } %>
        </div>
        <% if (it.email || it.homeUrl || it.confirm) { %>
        <div class="strip">
          <% if (it.email) { %>
          <p class="email"><%= it.email %></p>
          <% } %>
          <% if (it.homeUrl || it.confirm) { %>
          <nav aria-label="Other pages">
            <% if (it.confirm) { %>
            <a class="quiet" href="<%= it.manageUrl %>">Manage preferences</a>
            <% } %>
            <% if (it.homeUrl) { %>
            <a class="quiet" href="<%= it.homeUrl %>">Go to <%= it.h.APP_NAME %></a>
            <% } %>
          </nav>
          <% } %>
        </div>
        <% } %>
      </article>
    </div>
  </main>
</body>
</html>
