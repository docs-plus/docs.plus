discovery.docker "containers" {
  host = "tcp://docker-socket-proxy:2375"
}

discovery.relabel "docker" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "logs" {
  host       = "tcp://docker-socket-proxy:2375"
  targets    = discovery.relabel.docker.output
  forward_to = [loki.process.pino.receiver]
}

loki.process "pino" {
  // Loki's own info lines were half of all stored lines (#712). Keep warn, error and the
  // slow-query log. Fast query lines are almost all Grafana's own alert checks.
  stage.match {
    selector = "{service=\"loki\"} |~ \"^level=info \" !~ \"caller=metrics.go.* latency=slow\""
    action   = "drop"
  }
  // GlitchTip's scheduler logs three lines per routine task. Its lines carry no level, so
  // any line that names an error, a failure or a warning passes.
  stage.match {
    selector = "{service=\"glitchtip-worker\"} |~ \"Task .* (succeeded|finished)|Enqueuing due task|Processing task\" !~ \"(?i)error|exception|traceback|fail|warn|critical\""
    action   = "drop"
  }
  // The proxy logs every Docker API call. LOG_LEVEL does not quiet it on v0.5.0. Any status
  // but 200 still reaches Loki. A log stream cut after its 200 is dropped; Alloy reconnects.
  stage.match {
    selector = "{service=\"docker-socket-proxy\"} |~ \"dockerbackend/dockersocket \\\\S+ 200 \""
    action   = "drop"
  }
  stage.json {
    expressions = { level = "level" }
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
